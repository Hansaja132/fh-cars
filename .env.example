NODE_ENV=development
PORT=5000

# Initial Admin Credentials (used by database seed)
INITIAL_ADMIN_EMAIL="example@gmail.com"
INITIAL_ADMIN_PASSWORD="YourSecureAdminPassword123!"
INITIAL_ADMIN_USERNAME="admin"

# Generic SMTP Mail Server Configuration
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="smtp-user@example.com"
SMTP_PASS="smtp-password"
MAIL_FROM="FH6 Cars Database <noreply@example.com>"

# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=TestPassword123!
POSTGRES_DB=fh6_cars
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

DATABASE_URL="postgresql://postgres:TestPassword123%21@localhost:5432/fh6_cars?schema=public"

JWT_SECRET="fh6_super_secret_jwt_key_change_in_production_2026"
JWT_EXPIRES_IN="7d"

CORS_ORIGIN="http://localhost:5173"

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Supabase Storage Configuration
SUPABASE_URL="https://your-supabase-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
SUPABASE_KEY="your-supabase-anon-key"
SUPABASE_STORAGE_BUCKET="car_images"


